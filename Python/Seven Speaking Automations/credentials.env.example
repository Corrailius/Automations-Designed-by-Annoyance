SEVEN_SPEAKING_EMAIL=you@your-school.example
SEVEN_SPEAKING_PASSWORD=your-password

# ======================================================================
# Tuning. Every line is optional; delete one to get the built-in default.
# ======================================================================

# --- right / wrong answers (shuffled inside each cycle) ----------------
# 2 and 1 = "2 right, 1 wrong, random order, repeat". Wrong = 0 -> always right.
GOOD_ANSWERS_PER_CYCLE=2
WRONG_ANSWERS_PER_CYCLE=1

# --- already completed lessons -----------------------------------------
# They are replayed, never skipped, but picked less often than new ones.
# 1 = same as new lessons, 0.2 = five times less likely, 0 = never replay.
COMPLETED_WEIGHT=0.2

# --- pacing ------------------------------------------------------------
# Minutes spent per 10 announced minutes of quiz.
QUIZ_MINUTES_PER_10=5
# Clamp (seconds) for the wait before each answer. MAX=0 disables waiting.
MIN_THINK_SECONDS=2
MAX_THINK_SECONDS=25
# Random variation of each wait: 0.3 = +/-30%.
THINK_JITTER=0.3
# Pause between two news activities (seconds).
PAUSE_MIN_SECONDS=3
PAUSE_MAX_SECONDS=8

# --- advanced ----------------------------------------------------------
# Delay between API calls while listing the news topics (seconds).
# API_DELAY_MIN_SECONDS=0.8
# API_DELAY_MAX_SECONDS=1.6
# Seconds to wait for the page's own quiz request before calling the API.
# QUIZ_PAYLOAD_TIMEOUT=5
# Stop a section after this many failures in a row.
# MAX_CONSECUTIVE_FAILURES=3
